{
  "rewrites": [
    {
      "source": "/events/:slug",
      "has": [{ "type": "query", "key": "_src", "value": "app" }],
      "missing": [{ "type": "header", "key": "user-agent", "value": "facebookexternalhit|Facebot|FacebookBot|meta-externalagent|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|MicroMessenger" }],
      "destination": "/index.html"
    },
    {
      "source": "/events/:slug",
      "has": [{ "type": "query", "key": "admin" }],
      "destination": "/index.html"
    },
    {
      "source": "/events/:slug",
      "destination": "https://ollae-backend.fly.dev/og-preview/:slug"
    },
    {
      "source": "/og/:slug",
      "destination": "https://ollae-backend.fly.dev/og/:slug"
    },
    { "source": "/create", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/events/:slug",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
