{
  "rewrites": [
    {
      "source": "/events/:slug",
      "has": [{ "type": "query", "key": "_src", "value": "app" }],
      "missing": [{ "type": "header", "key": "user-agent", "value": "facebookexternalhit|Facebot|FacebookBot|meta-externalagent|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|MicroMessenger" }],
      "destination": "/index.html"
    },
    {
      "source": "/events/:slug",
      "has": [{ "type": "query", "key": "admin" }],
      "destination": "/index.html"
    },
    {
      "source": "/events/:slug",
      "destination": "https://ollae-backend.fly.dev/og-preview/:slug"
    },
    {
      "source": "/og/:slug",
      "destination": "https://ollae-backend.fly.dev/og/:slug"
    },
    { "source": "/create", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/events/:slug",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-transform" }]
    },
    {
      "source": "/((?!create$|events/wssrfd7v$).*)",
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }]
    },
    {
      "source": "/create",
      "missing": [{ "type": "query", "key": "embed", "value": "1" }],
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }]
    },
    {
      "source": "/create",
      "has": [{ "type": "query", "key": "embed", "value": "1" }],
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors https://www.matthewclau.com https://matthewclau.com http://localhost:4321" }]
    },
    {
      "source": "/events/wssrfd7v",
      "missing": [{ "type": "query", "key": "embed", "value": "1" }],
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }]
    },
    {
      "source": "/events/wssrfd7v",
      "has": [{ "type": "query", "key": "admin" }],
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }]
    },
    {
      "source": "/events/wssrfd7v",
      "has": [{ "type": "query", "key": "embed", "value": "1" }],
      "missing": [{ "type": "query", "key": "admin" }],
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors https://www.matthewclau.com https://matthewclau.com http://localhost:4321" }]
    },
    {
      "source": "/events/wssrfd7v",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
